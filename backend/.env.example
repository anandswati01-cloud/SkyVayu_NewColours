# =============================================================================
# SkyVayu API — environment template
#
# Copy to .env for local development:   cp .env.example .env
# Never commit .env — it is gitignored. In production set these as real
# environment variables on the host (Render dashboard / Docker secrets).
#
# Anything marked REQUIRED IN PRODUCTION aborts boot if missing.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Number of reverse proxies in front of the app (Render/Vercel = 1).
# Needed so rate limiting sees the real client IP. Defaults to 1 in production.
TRUST_PROXY=0

# ── Auth — REQUIRED IN PRODUCTION ────────────────────────────────────────────
# Must be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating these invalidates every issued token.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (migrations only) ───────────────────────────────────────────────
# Direct Postgres connection, used ONLY by the migration runner — the app itself
# talks to Supabase over REST. PostgREST cannot execute DDL, so schema changes
# need this.
#
# Supabase → Project Settings → Database → Connection string → URI
# Use the DIRECT or SESSION-mode string. The transaction pooler (port 6543)
# cannot hold the advisory lock the runner uses.
#
# Migrations run automatically at boot; set RUN_MIGRATIONS_ON_BOOT=false to
# apply them from a deploy step (npm run migrate) instead.
DATABASE_URL=
RUN_MIGRATIONS_ON_BOOT=true

# ── Supabase ─────────────────────────────────────────────────────────────────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REQUIRED IN PRODUCTION.
# The service role key bypasses row level security — server-side only.
# It must never appear in the frontend bundle or any VITE_* variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if your project still issues legacy HS256 access tokens
# (Project Settings → API → JWT Settings → JWT Secret). Projects using
# asymmetric signing keys are verified via JWKS and need nothing here.
SUPABASE_JWT_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────────
# Limits non-members to one charter query, then returns 403 MEMBERSHIP_REQUIRED.
# Keep this off until the /register page exists — otherwise users dead-end on
# their second query.
MEMBERSHIP_GATE_ENABLED=false

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=noreply@skyvayu.com
# Where new-query and new-quote notifications go. REQUIRED IN PRODUCTION.
ADMIN_EMAIL=ops@skyvayu.com

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Test keys start rzp_test_, live keys rzp_live_. Both come from
# Razorpay Dashboard → Account & Settings → API Keys.
# Without both, /api/payments fails closed with a 503 rather than booking free.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret — a DIFFERENT value from RAZORPAY_KEY_SECRET. You
# choose it yourself when creating the webhook:
#   Razorpay Dashboard → Settings → Webhooks → Add New Webhook
#   URL:    https://api.skyvayu.com/api/payments/webhook
#   Events: payment.captured, payment.failed, refund.processed
#
# The webhook is what confirms a booking when the customer's browser never makes
# it back from the payment page — closed tab, dead network, locked phone. Without
# this secret the endpoint rejects every delivery, and those bookings stay stuck
# on 'pending_payment' with the money already taken.
RAZORPAY_WEBHOOK_SECRET=

# ── CORS — REQUIRED IN PRODUCTION ────────────────────────────────────────────
# Comma-separated frontend origins, no trailing slash. These are the origins of
# the SITE, not of this API. In development any localhost port is allowed
# automatically, so this can be left empty locally.
# Example: https://skyvayu.com,https://www.skyvayu.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── SMS / phone verification — REQUIRED IN PRODUCTION ────────────────────────
# The charter form will not submit until the customer has verified a mobile
# number by OTP, so with no working provider nobody can request a quote.
#
# generic | msg91 | twilio | console
#   console prints the code to the server log and sends nothing. It is the
#   default in development and is REJECTED at boot in production.
SMS_PROVIDER=console
#
# ── generic: any Indian bulk-SMS gateway ─────────────────────────────────────
# Use this when you already hold a DLT-approved template on an existing SMS
# account. The URL below IS the request; placeholders are substituted and
# URL-encoded before it is called:
#
#   {phone}      +919876543210
#   {phone_bare} 919876543210      — what most Indian gateways want
#   {otp}        483920
#   {message}    SMS_TEMPLATE with {otp} filled in
#   {dlt_te_id}  DLT_TE_ID below
#   {dlt_pe_id}  DLT_PE_ID below
#
# A GET gateway puts its parameters in the URL. A POST one puts them in
# SMS_GATEWAY_BODY, sent form-encoded.
#
# Working example — smsidea.co.in:
#   SMS_GATEWAY_URL=https://smsidea.co.in/smsstatuswithid.aspx
#   SMS_GATEWAY_METHOD=POST
#   SMS_GATEWAY_BODY=mobile={user}&pass={pass}&senderid=SANSAT&to={phone_local}&otp={otp}&msg={message}&peid={dlt_pe_id}&templateid={dlt_te_id}
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=GET
SMS_GATEWAY_BODY=
#
# Gateway account login. Kept in their own variables so they are never part of
# a URL or body template that gets pasted into a config example or a ticket.
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
#
# The DLT-approved wording, CHARACTER FOR CHARACTER, with {otp} standing in for
# the registered template's {#var#}. Carriers match the delivered text against
# the registration and silently drop anything that differs — a changed comma is
# enough to stop delivery, with no error to explain it.
#   e.g. SMS_TEMPLATE=Dear User, {otp} is your OTP for Sanskar Tv verification. Sanskar Tv
SMS_TEMPLATE=
#
# TRAI DLT ids: the approved template, and the registered entity behind it.
DLT_TE_ID=
DLT_PE_ID=
#
# MSG91 — the India route. Read this before wiring it up:
#   Transactional SMS to Indian numbers requires TRAI DLT registration. The
#   entity and the message template must both be approved before ANY message
#   delivers; an unregistered send is silently dropped by the carriers, not
#   bounced back. Registration is done once, by the business, and takes days.
#   MSG91_TEMPLATE_ID is the approved template's id, and the variable inside
#   that template MUST be named `otp` — smsService sends it under that name, so
#   a template using a different variable name delivers a blank code.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Approved 6-character sender id, e.g. SKYVYU. Optional; MSG91 falls back to the
# account default.
MSG91_SENDER_ID=
#
# Twilio — better for international numbers. Indian numbers still need the same
# DLT registration, done on Twilio's side.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── OTP behaviour ────────────────────────────────────────────────────────────
# Defaults are sensible; override only with a reason. A longer TTL or a higher
# attempt ceiling both make a six-digit code easier to guess.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Per number, per rolling 24h. Every send costs money and rings a real handset.
OTP_MAX_PER_PHONE_PER_DAY=10
# Per origin IP, per rolling hour. Stops one host walking a list of numbers.
OTP_MAX_PER_IP_PER_HOUR=20
# How long a completed verification is remembered by the browser, so a repeat
# customer is not asked to verify on every visit.
PHONE_TOKEN_TTL_DAYS=30
