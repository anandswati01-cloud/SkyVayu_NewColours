# =============================================================================
# SkyVayu frontend — environment template
#
# Copy to .env for local development:   cp .env.example .env
# In production set these in the hosting dashboard (Vercel → Settings →
# Environment Variables) BEFORE building — Vite inlines them at build time, so
# changing a value requires a redeploy, not just a restart.
#
# ⚠ EVERYTHING HERE IS PUBLIC.
# Vite bakes every VITE_* variable into the JavaScript bundle in plain text.
# Only publishable values belong in this file. Never add a Supabase service
# role key, a Razorpay key secret, a JWT secret, or any other credential —
# those live on the backend only.
# =============================================================================

# Base URL of the SkyVayu API, no trailing slash.
# Local: http://localhost:5000 (must match backend PORT)
# Production: https://api.skyvayu.com
VITE_API_URL=http://localhost:5000

# Supabase project URL and ANON (publishable) key.
# Find both at: Supabase dashboard → Project Settings → API
# The anon key is safe to expose — access is constrained by row level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Invoice identity (optional) ──────────────────────────────────────────────
# Printed on the tax invoice customers download after booking. All public.
# Leave blank until the entity is registered — each line is simply omitted from
# the invoice rather than printed empty.
#
# A GST-registered supplier charging 18% must show its GSTIN and place of supply
# on the invoice, so fill these in before taking live payments.
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_GSTIN=
# Place of supply, e.g. "Maharashtra (27)"
VITE_COMPANY_STATE=
